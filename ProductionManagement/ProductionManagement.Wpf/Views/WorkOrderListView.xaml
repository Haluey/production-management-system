<UserControl x:Class="ProductionManagement.Wpf.Views.WorkOrderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             Loaded="WorkOrderListView_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="작업지시 관리"
           FontSize="24"
           FontWeight="Bold"
           Margin="0,0,0,16"/>

        <Border Grid.Row="1"
                BorderBrush="#DCE2EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <!-- 새 작업지시 등록 -->
            <StackPanel x:Name="WorkOrderInputPanel"
                        Grid.Row="1"
                        Margin="0,0,0,16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="작업지시 번호" Margin="0,0,0,6"/>
                        <TextBox Height="32"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding WorkOrderNo, Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="생산할 제품" Margin="0,0,0,6"/>

                        <ComboBox Height="32"
                                  ItemsSource="{Binding ActiveProducts}"
                                  SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProductCode}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ProductName}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="생산 예정일" Margin="0,0,0,6"/>
                        <DatePicker Height="32"
                                    SelectedDate="{Binding PlannedDate, Mode=TwoWay}"
                                    SelectedDateFormat="Short"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="목표 수량" Margin="0,0,0,6"/>
                        <TextBox Height="32"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding TargetQuantityText, Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="비고 (선택)" Margin="0,0,0,6"/>
                        <TextBox Height="32"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Memo, Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <dx:SimpleButton Grid.Column="1"
                                     Content="작업지시 등록"
                                     Width="120"
                                     Height="32"
                                     VerticalAlignment="Bottom"
                                     Click="CreateWorkOrder_Click"/>
                </Grid>
            </StackPanel>

        </Border>

        <Border Grid.Row="2"
                BorderBrush="#DCE2EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">

            <StackPanel>
                <TextBlock Text="작업지시 조회"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

                <!-- 작업지시 조회 조건 -->
                <Grid x:Name="FilterPanel"
                  Grid.Row="2"
                  Margin="0,0,0,16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="예정일 시작" Margin="0,0,0,6"/>
                    <DatePicker Height="32"
                        SelectedDate="{Binding FilterStartDate, Mode=TwoWay}"
                        SelectedDateFormat="Short"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="예정일 종료" Margin="0,0,0,6"/>
                    <DatePicker Height="32"
                        SelectedDate="{Binding FilterEndDate, Mode=TwoWay}"
                        SelectedDateFormat="Short"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="조회 상태" Margin="0,0,0,6"/>
                    <ComboBox Height="32"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding FilterStatus, Mode=TwoWay}">
                        <ComboBoxItem Content="전체" Tag="All"/>
                        <ComboBoxItem Content="대기" Tag="Waiting"/>
                        <ComboBoxItem Content="진행 중" Tag="InProgress"/>
                        <ComboBoxItem Content="완료" Tag="Completed"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="검색어 (작업지시 번호·제품 코드·제품명)"
                       Margin="0,0,0,6"/>
                    <TextBox Height="32"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchKeyword, Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- 입력한 조건으로 조회하거나 조건 초기화 -->
                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">

                    <dx:SimpleButton x:Name="ResetFiltersButton"
                         Content="조회 조건 초기화"
                         Width="130"
                         Height="32"
                         Margin="0,0,8,0"
                         Click="ResetFilters_Click"/>

                    <dx:SimpleButton x:Name="RefreshButton"
                         Content="조회"
                         Width="100"
                         Height="32"
                         Click="RefreshWorkOrders_Click"/>
                </StackPanel>
            </Grid>

            </StackPanel>
        </Border>

        <!-- 선택한 작업 처리와 조회 결과 저장 -->
        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <dx:SimpleButton x:Name="ExportCsvButton"
                     DockPanel.Dock="Right"
                     Content="CSV 저장"
                     Width="100"
                     Height="32"
                     Click="ExportCsv_Click"/>

            <StackPanel DockPanel.Dock="Right"
                Orientation="Horizontal"
                Margin="0,0,12,0">

                <dx:SimpleButton x:Name="StartButton"
                         Content="작업 시작"
                         Width="100"
                         Height="32"
                         Margin="0,0,8,0"
                         Click="StartWorkOrder_Click"/>

                <dx:SimpleButton x:Name="CompleteButton"
                         Content="작업 완료"
                         Width="100"
                         Height="32"
                         Click="CompleteWorkOrder_Click"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="작업지시 목록"
                   FontSize="16"
                   FontWeight="Bold"/>

                <TextBlock Text="목록에서 작업지시를 선택한 뒤 시작·완료할 수 있습니다."
                   Foreground="#666666"
                   Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 작업지시 목록 -->
        <dxg:GridControl x:Name="WorkOrderGrid"
                         Grid.Row="4"
                         ItemsSource="{Binding WorkOrders}"
                         SelectedItem="{Binding SelectedWorkOrder, Mode=TwoWay}"
                         AutoGenerateColumns="None">

            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="WorkOrderNo"
                    Header="작업지시 번호"
                    Width="180"/>

                <dxg:GridColumn FieldName="ProductCode"
                    Header="제품 코드"
                    Width="90"/>

                <dxg:GridColumn FieldName="ProductName"
                    Header="제품명"
                    Width="120"/>

                <dxg:GridColumn FieldName="PlannedDate"
                    Header="생산 예정일"
                    Width="100"/>

                <dxg:GridColumn FieldName="TargetQuantity"
                    Header="목표 수량"
                    Width="80"/>

                <dxg:GridColumn FieldName="TotalGoodQuantity"
                    Header="양품 합계"
                    Width="80"/>

                <dxg:GridColumn FieldName="TotalDefectQuantity"
                    Header="불량 합계"
                    Width="80"/>

                <dxg:GridColumn FieldName="AchievementRate"
                    Header="달성률(%)"
                    Width="90"/>

                <dxg:GridColumn FieldName="Unit"
                    Header="단위"
                    Width="55"/>

                <dxg:GridColumn FieldName="StatusName"
                    Header="상태"
                    Width="75"/>
            </dxg:GridControl.Columns>

            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="False"
                               AllowEditing="False"
                               NavigationStyle="Row"
                               ShowGroupPanel="False"/>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>