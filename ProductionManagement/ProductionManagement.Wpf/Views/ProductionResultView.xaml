<UserControl x:Class="ProductionManagement.Wpf.Views.ProductionResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid">

    <Grid x:Name="ContentGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <dx:SimpleButton DockPanel.Dock="Right"
                             Content="작업지시 불러오기"
                             Width="140"
                             Height="36"
                             Click="LoadWorkOrders_Click"/>

            <TextBlock Text="생산실적 관리"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 실적을 조회하거나 등록할 작업지시 선택 -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Height="36"
                      Margin="0,0,12,0"
                      ItemsSource="{Binding WorkOrders}"
                      SelectedItem="{Binding SelectedWorkOrder, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding WorkOrderNo}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding ProductName}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding StatusName}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <dx:SimpleButton Grid.Column="1"
                             Content="실적 조회"
                             Width="100"
                             Height="36"
                             Click="LoadResults_Click"/>
        </Grid>

        <!-- 생산실적 입력 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="진행 중인 작업에 생산실적 등록"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="생산일" Margin="0,0,0,6"/>
                    <DatePicker Height="32"
                                SelectedDate="{Binding ProductionDate, Mode=TwoWay}"
                                SelectedDateFormat="Short"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="양품 수량" Margin="0,0,0,6"/>
                    <TextBox Height="32"
                             VerticalContentAlignment="Center"
                             Text="{Binding GoodQuantityText, Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="불량 수량" Margin="0,0,0,6"/>
                    <TextBox Height="32"
                             VerticalContentAlignment="Center"
                             Text="{Binding DefectQuantityText, Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="비고 (선택)" Margin="0,0,0,6"/>
                    <TextBox Height="32"
                             VerticalContentAlignment="Center"
                             Text="{Binding Memo, Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <dx:SimpleButton Grid.Column="1"
                                 Content="실적 등록"
                                 Width="100"
                                 Height="32"
                                 VerticalAlignment="Bottom"
                                 Click="CreateResult_Click"/>
            </Grid>
        </StackPanel>

        <!-- 선택한 작업지시의 실적 목록 -->
        <dxg:GridControl Grid.Row="3"
                         ItemsSource="{Binding Results}"
                         AutoGenerateColumns="None">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="ProductionResultId" Header="실적 ID"/>
                <dxg:GridColumn FieldName="ProductionDate" Header="생산일"/>
                <dxg:GridColumn FieldName="GoodQuantity" Header="양품 수량"/>
                <dxg:GridColumn FieldName="DefectQuantity" Header="불량 수량"/>
                <dxg:GridColumn FieldName="Memo" Header="비고"/>
            </dxg:GridControl.Columns>

            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True"
                               AllowEditing="False"
                               ShowGroupPanel="False"/>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>