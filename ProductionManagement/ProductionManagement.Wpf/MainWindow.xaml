<Window x:Class="ProductionManagement.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Title="생산 작업지시·실적 관리"
        Height="550"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <dx:SimpleButton x:Name="RefreshButton"
                             DockPanel.Dock="Right"
                             Content="제품 조회"
                             Width="100"
                             Height="36"
                             Click="RefreshProducts_Click"/>

            <TextBlock Text="제품 목록"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- ViewModel의 Products 목록을 표에 연결 -->
        <dxg:GridControl Grid.Row="1"
                         ItemsSource="{Binding Products}"
                         AutoGenerateColumns="None">

            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="ProductId" Header="ID"/>
                <dxg:GridColumn FieldName="ProductCode" Header="제품 코드"/>
                <dxg:GridColumn FieldName="ProductName" Header="제품명"/>
                <dxg:GridColumn FieldName="Unit" Header="단위"/>
                <dxg:GridColumn FieldName="IsActive" Header="사용 여부"/>
            </dxg:GridControl.Columns>

            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True"
                               AllowEditing="False"
                               ShowGroupPanel="False"/>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</Window>